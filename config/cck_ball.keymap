#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
// Это СКОРОСТЬ, а не «пиксели за щелчок». За один тик &msc набегает
// SCRL_VAL * trigger-period-ms / 1000, отправляется только целая часть,
// остаток копится и обнуляется при отпускании (behavior_input_two_axis.c).
// Расчёт при периоде 16 мс: 70 * 16/1000 = 1.12 => единица набирается за ПЕРВЫЙ
// тик, движение начинается через ~16 мс. С прежними 40 (0.64 за тик) событие
// уходило лишь на втором тике, ~32 мс — это ощущалось как пауза перед стартом.
// Второго события не будет: при tap-ms 30 отпускание наступает раньше
// следующего тика (32 мс). Одно событие = один клик колеса (scaler 1:1).
#define ZMK_POINTING_DEFAULT_SCRL_VAL 70

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

// Множитель 1:1 — одно событие скролла = один «клик» колеса (100 px).
// С вендорским 2:1 каждый щелчок давал двойной клик (замер: 200 px).
&msc_input_listener { input-processors = <&zip_scroll_scaler 1 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
    // Период тиков оставлен ДЕФОЛТНЫМ (16 мс). Пробовали 8 мс с коротким
    // tap-ms — событие не уходило вообще: тик выполняется в системной
    // очереди работ и при занятости (BLE, опрос матрицы) не успевает до
    // release, который его отменяет (k_work_cancel_delayable).
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

// Фильтр дребезга энкодеров. Симптом при вендорских 800 мкс: изредка «проскок»
// назад — щелчок будто крутнули обратно, а потом снова вперёд. Драйвер считает
// обратный щелчок глитчем, только если тот уложился в это окно после перехода
// в ту же сторону; 800 мкс для этих энкодеров мало. 5000 мкс безопасно:
// настоящий реверс требует остановиться и крутнуть назад, это десятки мс.
// ⚠️ Фильтр работает в драйвере на ТОЙ половине, где физически стоит энкодер:
// для левого энкодера правка вступит в силу только после прошивки ЛЕВОЙ половины.
&left_encoder  { filter-reverse-guard-us = <5000>; };
&right_encoder { filter-reverse-guard-us = <5000>; };

/ {
    // 上下滚动编码器行为
    // tap-ms — компромисс двух ИЗМЕРЕННЫХ границ:
    //  * слишком МАЛО (12-14 мс) => тик &msc не успевает выполниться до release,
    //    который его отменяет, и не уходит НИ ОДНОГО события (проверено);
    //  * слишком МНОГО (вендорские 100 мс) => очередь поведений тянет лишь
    //    ~10 щелчков/с, при быстром вращении переполняется, теряются release,
    //    и непрерывное &msc залипает нажатым => прокрутка сама по себе
    //    (замер: 59 событий/с в полном покое).
    // 30 мс: событие уходит на первом тике (16 мс), запас до отпускания 14 мс,
    // второй тик (32 мс) уже не наступает => ровно одно событие на щелчок.
    // Очередь тянет ~33 щелчка/с при буфере 512 элементов.
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        // Порядок: первый binding — по часовой, второй — против.
        // Вендорский порядок (DOWN, UP) давал на правом энкодере движение
        // в обратную сторону — поменян местами.
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        tap-ms = <30>;
    };

    // 左右滚动编码器行为
    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        // Порядок: по часовой, против. Поменян местами — направление
        // горизонтали было обратным (как и у вертикали).
        bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
        tap-ms = <30>;
    };
    
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC           &kp N1        &kp N2        &kp N3      &kp N4     &kp N5  &kp N6  &kp N7     &kp N8     &kp N9          &kp N0          &kp BACKSPACE
&kp TAB           &kp Q         &kp W         &kp E       &kp R      &kp T   &kp Y   &kp U      &kp I      &kp O           &kp P           &kp BSLH
&kp CAPSLOCK      &kp A         &kp S         &kp D       &lt 3 F    &kp G   &kp H   &kp J      &kp K      &kp L           &kp SEMI        &kp SQT
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C       &kp V      &kp B   &kp N   &kp M      &kp COMMA  &kp DOT         &kp UP_ARROW    &kp FSLH
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &kp DELETE  &kp SPACE  &mo 1   &mo 2   &kp SPACE  &kp ENTER  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            // Базовый слой: прокрутка на обоих энкодерах.
            // Порядок = sensors = <&left_encoder &right_encoder> (cck_ball.dtsi):
            // первый binding — ЛЕВЫЙ, второй — ПРАВЫЙ.
            // Громкость и PgUp/PgDn переехали на F_layers (&mo 1).
            sensor-bindings = <&scroll_horizontal_encoder>,  // левый: влево/вправо
                              <&scroll_vertical_encoder>;    // правый: вверх/вниз
        };

        F_layers {
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6     &kp F7     &kp F8  &kp F9  &kp F10  &kp F11
&kp A    &none   &none   &none   &none   &trans  &none      &none      &none   &trans  &trans   &trans
&trans   &none   &none   &none   &none   &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &none   &none      &none      &trans  &trans  &none    &trans
&trans   &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans  &trans  &trans  &trans  &kp W
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans        &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_vertical_encoder>,   // 编码器1：上下滚动
                             <&scroll_horizontal_encoder>;  // 编码器2：左右滚动
        };
    };
};
